# Plantilla de variables de entorno de CIMENTA.
#
# Se copia a `.env` en la raíz del repositorio (cp .env.example .env) y cada
# desarrollador rellena su copia. `.env` nunca se versiona (RNF-07): contiene
# valores locales y está ignorado por .gitignore.
#
# Cada ticket añade aquí las claves que introduce y ninguna más:
#   - TKT-003: base de datos (conexión de la aplicación y del rol de migración).
#   - TKT-006: sesión y parámetros de Argon2 (opcionales).
#   - TKT-057: contraseñas de los roles sin valor, origen del almacén y límites de intentos.
#   - TKT-059: almacén de objetos compatible con S3 (MinIO en local).
#
# Ninguna clave de este archivo lleva nunca un secreto real. Los secretos viven
# solo en el `.env` local, en variables del entorno de ejecución o en GitHub Secrets.

# --- Base de datos · TKT-003 --------------------------------------------------
# PostgreSQL local del servicio db de compose.yaml. Valores de desarrollo,
# evidentes a propósito: en cualquier otro entorno se sustituyen.
CIMENTA_DB_HOST=127.0.0.1
CIMENTA_DB_PUERTO=5432
CIMENTA_DB_NOMBRE=cimenta
# Contraseñas de los tres roles de PostgreSQL. Van SIN valor a propósito: cada
# persona define las suyas en su `.env`, por ejemplo con
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# La aplicación solo necesita la de APLICACION. MIGRACION la usan alembic y las
# herramientas (y la imagen de PostgreSQL en el primer arranque); LECTURA, un
# módulo futuro. La migración crea los roles de aplicación y de solo lectura sin
# contraseña; se fijan después, desde backend/:
#   uv run --env-file ../.env python -m herramientas.contrasenas_roles
CIMENTA_DB_CONTRASENA_MIGRACION=
CIMENTA_DB_CONTRASENA_APLICACION=
CIMENTA_DB_CONTRASENA_LECTURA=

# --- Usuario de prueba · TKT-008b ---------------------------------------------
# Credenciales de PRUEBA para iniciar sesión a mano en local. No son un secreto:
# el usuario solo existe en la base local, donde lo crea el script de siembra
# (ver README, «Entrega 2»), que se niega a escribir en un host que no sea local.
# Rol COMPRAS. No las uses en ningún otro entorno.
CIMENTA_PRUEBA_CORREO=prueba.compras@cimenta.test
CIMENTA_PRUEBA_CONTRASENA=Cimenta-Prueba-2026

# --- Sesión y contraseñas · TKT-006 -------------------------------------------
# Opcionales: sin ellas valen los de omisión.
# CIMENTA_SESION_CADUCIDAD_MINUTOS=720
# CIMENTA_SESION_INACTIVIDAD_MINUTOS=30
# CIMENTA_ARGON2_TIEMPO=          # sin valor: el de argon2-cffi
# CIMENTA_ARGON2_MEMORIA_KIB=     # sin valor: el de argon2-cffi
# CIMENTA_ARGON2_PARALELISMO=     # sin valor: el de argon2-cffi

# --- Endurecimiento HTTP · TKT-057 --------------------------------------------
# Origen del almacén de objetos (https, o http solo en localhost; sin ruta). Opcional hasta TKT-059;
# permite que la política de contenido de la aplicación acepte las URL prefirmadas.
# CIMENTA_ALMACEN_ORIGEN=
# Límite de intentos fallidos de inicio de sesión. Opcionales: sin ellas valen los de omisión.
# CIMENTA_LIMITE_FALLOS_CUENTA=5     # fallos por cuenta dentro de la ventana
# CIMENTA_LIMITE_FALLOS_ORIGEN=20    # fallos por origen dentro de la ventana
# CIMENTA_LIMITE_MINUTOS=15          # duración de la ventana, en minutos
